PORT=3000
# Local (coincide con docker-compose.yml en esta carpeta)
DATABASE_URL=postgresql://evolution:evolution_dev@localhost:5433/evolution_erp
# Opcional: máximo de conexiones en el pool
# PGPOOL_MAX=10

# JWT (mínimo 16 caracteres en producción)
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=8h

# Solo para `npm run db:seed-admin` (primer super admin + almacén Principal)
# SEED_ADMIN_EMAIL=admin@evolution.local
# SEED_ADMIN_PASSWORD=
# Si el usuario ya existe: pon la nueva clave arriba y descomenta la siguiente línea para actualizarla
# SEED_RESET_ADMIN_PASSWORD=1
